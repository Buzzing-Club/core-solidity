xceededMaxMint();\n    error ERC4626ExceededMaxWithdraw();\n    error ERC4626ExceededMaxRedeem();\n}\n"}},"settings":{"evmVersion":"london","optimizer":{"enabled":true,"runs":200},"viaIR":true,"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/interfaces/IBLPToken.sol":{"ast":{"absolutePath":"contracts/interfaces/IBLPToken.sol","exportedSymbols":{"IBLPToken":[101]},"id":102,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","0.8",".20"],"nodeType":"PragmaDirective","src":"32:23:0"},{"abstract":false,"baseContracts":[],"canonicalName":"IBLPToken","contractDependencies":[],"contractKind":"interface","documentation":{"id":2,"nodeType":"StructuredDocumentation","src":"57:47:0","text":" @dev Interface for BLPToken contract"},"fullyImplemented":false,"id":101,"linearizedBaseContracts":[101],"name":"IBLPToken","nameLocation":"115:9:0","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IBLPToken.Meta","id":7,"members":[{"constant":false,"id":4,"mutability":"mutable","name":"name","nameLocation":"161:4:0","nodeType":"VariableDeclaration","scope":7,"src":"154:11:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_string_storage_ptr","typeString":"string"},"typeName":{"id":3,"name":"string","nodeType":"ElementaryTypeName","src":"154:6:0","typeDescriptions":{"typeIdentifier":"t_string_storage_ptr","typeString":"string"}},"visibility":"internal"},{"constant":false,"id":6,"mutability":"mutable","name":"symbol","nameLocation":"182:6:0","nodeType":"VariableDeclaration","scope":7,"src":"175:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_string_storage_ptr","typeString":"string"},"typeName":{"id":5,"name":"string","nodeType":"ElementaryTypeName","src":"175:6:0","typeDescriptions":{"typeIdentifier":"t_string_storage_ptr","typeString":"string"}},"visibility"